# ==============================================================================
# SEOScribe Server Configuration
# ==============================================================================

# Server Port & CORS
PORT=5000
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. AI & LLM Engine (Required for Multi-Agent Orchestration & Visual PDF Parsing)
# ------------------------------------------------------------------------------
# Google Gemini API key (Gemini 2.5 Flash)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Document Parsing Engines
# ------------------------------------------------------------------------------
# LlamaParse API key (for high-fidelity tabular & structured PDF extraction)
# Get your free tier key at: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# ------------------------------------------------------------------------------
# 3. Web Extraction & Scraping Waterfall (Optional but Recommended)
# ------------------------------------------------------------------------------
# Firecrawl API Key (Tier-1 Web Extraction: converts live sites to clean LLM markdown)
# Get your key at: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ScrapingBee API Key (Tier-2 Stealth Gateway: residential proxies & anti-bot bypass)
# Get your key at: https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here
